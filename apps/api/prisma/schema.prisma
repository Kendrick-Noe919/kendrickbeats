generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id
  email        String   @unique
  displayName  String
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  @@map("users")
}